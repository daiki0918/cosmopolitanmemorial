NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Public website URL used in customer SMS links (set to your deployed domain).
PUBLIC_WEB_URL=
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Cloudflare Turnstile secret key (API runtime)
TURNSTILE_SECRET_KEY=
# Gmail account that sends customer status emails; use a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# TextBee API key for opt-in inquiry status SMS notifications.
TEXTBEE_API_KEY=
# Optional TextBee Android device ID; omit to use the account's default device.
TEXTBEE_DEVICE_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Web (public only)
VITE_API_URL=/api/v1
VITE_MAP_STYLE_URL=
# Cloudflare Turnstile site key (public; available when building the web app)
VITE_TURNSTILE_SITE_KEY=
